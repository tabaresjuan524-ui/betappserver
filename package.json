{
  "main": "index.ts",
  "scripts": {
    "start": "node --max-old-space-size=4096 --expose-gc -r ts-node/register src/index.ts",
    "dev": "nodemon --exec node --max-old-space-size=4096 --expose-gc -r ts-node/register src/index.ts",
    "dev:log": "nodemon --exec node --max-old-space-size=4096 --expose-gc -r ./logger.js -r ts-node/register src/index.ts",
    "start:log": "node --max-old-space-size=4096 --expose-gc -r ./logger.js -r ts-node/register src/index.ts",
    "view-log": "node view-latest-log.js",
    "logs": "node view-latest-log.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "nodemon": "^3.1.10",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/ws": "^8.18.1",
    "puppeteer": "^24.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
